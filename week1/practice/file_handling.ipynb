   "source": [
    "### 20. Create and read a text file"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "251120ac",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "My name is Rojita.\n"
     ]
    }
   ],
   "source": [
    "# Create and write a file\n",
    "file = open(\"student.txt\", \"w\")\n",
    "\n",
    "file.write(\"My name is Rojita.\")\n",
    "file.close()\n",
    "\n",
    "# Read the file\n",
    "file = open(\"student.txt\", \"r\")\n",
    "\n",
    "content = file.read()\n",
    "\n",
    "print(content)\n",
    "\n",
    "file.close()"
   ]
  }
 ],
